# ==============================================================================
# FAZZTRACK FINANCE DASHBOARD - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Auth & Database (Recommended & Ready to publish)
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy the Project URL and anon/public API Key into the variables below:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: If these keys are not set or left empty, the application automatically
# runs in resilient Local / Demo Mode (pre-authenticated as Jenny Stacy), allowing
# instant offline testing without any blockers.
